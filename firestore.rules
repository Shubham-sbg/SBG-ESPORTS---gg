rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /store_data/{document=**} {
      allow read, write: if true;
    }
    match /image_metadata/{document=**} {
      allow read, write: if true;
    }
    match /uploaded_files/{document=**} {
      allow read, write: if true;
    }
    match /site_settings/{document=**} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
