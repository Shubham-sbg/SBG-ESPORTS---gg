# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Environment variables — never commit real secrets
.env
.env.*
!.env.example
*.env
artifacts/*/.env
deploy/.env

# Firebase & Cloud Service Account Keys / Private Keys
*service-account*.json
*service_account*.json
firebase-key*.json
*.pem
*.key
*.p12
id_rsa*

# Dependencies
node_modules
/.pnpm-store

# Compiled / Build Output
dist
build
tmp
out-tsc
*.tsbuildinfo
artifacts/*/dist
artifacts/*/build

# Local file-based databases & runtime uploads
artifacts/api-server/database/uploads/
artifacts/database/
*.db
*.sqlite
*.sqlite3

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
testem.log
libpeerconnection.log
/connect.lock
/coverage
.cache/
.local/
temp/

# IDEs and Editors
/.idea
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# System Files
.DS_Store
Thumbs.db

