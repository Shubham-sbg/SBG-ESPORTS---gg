{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "start": "node server.ts",
    "dev": "concurrently \"npm run dev -w @workspace/api-server\" \"npm run dev -w @workspace/sbg-army\"",
    "build": "npm run build -w @workspace/api-server && npm run build -w @workspace/sbg-army",
    "build:army": "npm run build -w @workspace/sbg-army",
    "build:server": "npm run build -w @workspace/api-server",
    "typecheck": "tsc --build",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "concurrently": "^9.1.2",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "@types/compression": "^1.8.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "jpeg-js": "^0.4.4",
    "pg": "^8.23.0",
    "pngjs": "^7.0.0"
  }
}
