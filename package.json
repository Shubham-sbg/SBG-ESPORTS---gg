{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "start": "node server.ts",
    "dev": "concurrently \"bun run dev --workspace=@workspace/api-server\" \"bun run dev --workspace=@workspace/sbg-army\"",
    "build": "bun run build --workspace=@workspace/api-server && bun run build --workspace=@workspace/sbg-army",
    "typecheck": "tsc --build",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "concurrently": "^9.1.2",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "@types/compression": "^1.8.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "jpeg-js": "^0.4.4",
    "pg": "^8.23.0",
    "pngjs": "^7.0.0"
  }
}
